{
  "name": "vivaldi-fullscreen-stay",
  "version": "2.0.0",
  "private": true,
  "description": "Vivaldi fullscreen video workaround, security checks and controlled performance measurements",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "check": "node scripts/security-check.cjs",
    "secrets": "python3 scripts/gitleaks.py",
    "audit": "npm audit --audit-level=moderate",
    "precommit": "npm run check && npm test && npm run secrets -- --staged",
    "prepare": "git config core.hooksPath .githooks",
    "package": "python3 scripts/package-release.py",
    "performance": "node scripts/measure-performance.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "acorn": "8.19.0"
  }
}
