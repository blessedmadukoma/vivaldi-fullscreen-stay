{
  "manifest_version": 3,
  "name": "Fullscreen Stay",
  "version": "2.0.0",
  "description": "Keep Vivaldi in Mac fullscreen when leaving HTML video players, including embedded streams.",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "content.js"
      ],
      "css": [
        "player.css"
      ],
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Fullscreen Stay",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
